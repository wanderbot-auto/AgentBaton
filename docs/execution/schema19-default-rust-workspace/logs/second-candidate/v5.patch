+fn record_files(path: &std::path::Path, boundary: &str) {
+    let output = std::path::PathBuf::from(std::env::var_os("AB_SCHEMA19_RAW_DIAGNOSTIC").unwrap());
+    for (name, suffix) in [("main", ""), ("wal", "-wal"), ("shm", "-shm")] {
+        let mut source = path.as_os_str().to_os_string();
+        source.push(suffix);
+        match std::fs::read(source) {
+            Ok(bytes) => {
+                println!("{boundary} {name}: present, {} bytes", bytes.len());
+                std::fs::write(output.join(format!("{boundary}-{name}")), bytes).unwrap();
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                println!("{boundary} {name}: absent");
+            }
+            Err(error) => panic!("{boundary} {name}: {error}"),
+        }
+    }
+}
