{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbaton.invalid/schemas/analysis-output.v1.json",
  "title": "Example data-analysis output contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_ref",
    "scope",
    "methods",
    "findings",
    "reproduction_ref",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "dataset_ref": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "full",
        "sample"
      ]
    },
    "sample_description": {
      "type": "string",
      "minLength": 1
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "evidence_refs"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "reproduction_ref": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "sample"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "required": [
          "sample_description"
        ]
      }
    }
  ]
}
