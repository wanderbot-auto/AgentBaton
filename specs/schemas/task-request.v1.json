{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbaton.invalid/schemas/task-request.v1.json",
  "title": "AgentBaton TaskRequest v1 (design draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "idempotency_key",
    "goal",
    "task_type",
    "workspace_id",
    "target",
    "inputs",
    "outputs",
    "policy",
    "limits",
    "acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "parent_task_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "enum": [
        "coding",
        "data_analysis",
        "review",
        "research",
        "general"
      ]
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "installation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_ref",
          "integrity",
          "access"
        ],
        "properties": {
          "resource_ref": {
            "type": "string",
            "minLength": 1
          },
          "integrity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "sha256",
                  "immutable_version",
                  "mutable_unverified"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "access": {
            "enum": [
              "read"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "relative_path",
          "media_type",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "relative_path": {
            "type": "string",
            "minLength": 1,
            "description": "Must also pass runtime canonicalization/root/symlink checks; schema is not a sandbox."
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "registered_schema_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "included_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_ref",
        "input_access",
        "output_access",
        "network_request",
        "require_enforcement"
      ],
      "properties": {
        "policy_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "input_access": {
          "const": "read"
        },
        "output_access": {
          "const": "artifact_root_write"
        },
        "network_request": {
          "enum": [
            "deny",
            "allowlisted",
            "native_policy"
          ]
        },
        "require_enforcement": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "input_read_only",
              "output_root_only",
              "network_policy"
            ]
          }
        },
        "allowed_mcp_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "uniqueItems": true
        },
        "side_effect_class": {
          "enum": [
            "artifact_only",
            "workspace_write",
            "external_write"
          ]
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "max_child_tasks",
        "max_delegation_depth",
        "max_duration_seconds"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "max_child_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "max_delegation_depth": {
          "type": "integer",
          "minimum": 0
        },
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validator_ids",
        "mode"
      ],
      "properties": {
        "validator_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "uniqueItems": true
        },
        "mode": {
          "enum": [
            "manual",
            "preapproved_rule"
          ]
        },
        "approval_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      }
    },
    "profile_revision": {
      "type": "string",
      "minLength": 1
    },
    "capability_snapshot_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "extensions": {
      "type": "object"
    }
  },
  "description": "Internal contract only. Authorization, input immutability, path safety and enforcement availability require semantic validation."
}
