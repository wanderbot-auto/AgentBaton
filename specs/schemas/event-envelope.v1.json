{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbaton.invalid/schemas/event-envelope.v1.json",
  "title": "AgentBaton EventEnvelope v1 (design draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "aggregate_id",
    "sequence",
    "kind",
    "occurred_at",
    "recorded_at",
    "source",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "aggregate_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "causation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "raw_ref": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "evidence_level"
      ],
      "properties": {
        "type": {
          "enum": [
            "provider_runtime",
            "baton_validator",
            "config_parser",
            "remote_host",
            "user",
            "inference"
          ]
        },
        "evidence_level": {
          "enum": [
            "observed",
            "provider_reported",
            "inferred",
            "unknown"
          ]
        },
        "installation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        }
      }
    }
  }
}
